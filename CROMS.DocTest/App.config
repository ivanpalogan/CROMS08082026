<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!--
    The harness must connect to the SAME database the application does. Without this the
    office vocabulary (DocVocabulary) comes back empty and the measurement silently
    reports a weaker pipeline than the one staff actually run - a harness that tests a
    different configuration is not testing the application.
  -->
  <connectionStrings>
    <add name="Croms"
         providerName="MySql.Data.MySqlClient"
         connectionString="server=localhost;port=3306;database=croms;user id=root;password=ofAEusyUEy2DjvAnK2Z1;SslMode=Disabled;AllowPublicKeyRetrieval=True;Convert Zero Datetime=True;" />
  </connectionStrings>
</configuration>
