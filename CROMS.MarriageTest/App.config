<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!-- Same database the application uses: a workflow test against a different
       configuration is not testing the application. -->
  <connectionStrings>
    <add name="Croms"
         providerName="MySql.Data.MySqlClient"
         connectionString="server=localhost;port=3306;database=croms;user id=root;password=@ivan123;SslMode=Disabled;AllowPublicKeyRetrieval=True;Convert Zero Datetime=True;" />
  </connectionStrings>
</configuration>
