<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!-- No password here, on purpose. Scripts\SampleData\Run-SampleData.ps1 writes the real
       connection string (demo or live) next to the exe at run time and deletes it afterwards. -->
  <connectionStrings>
    <add name="Croms" providerName="MySql.Data.MySqlClient"
         connectionString="server=localhost;port=3306;database=croms_demo;user id=SET_AT_RUN_TIME;password=SET_AT_RUN_TIME;SslMode=Required;AllowPublicKeyRetrieval=True;Convert Zero Datetime=True;" />
  </connectionStrings>
</configuration>
