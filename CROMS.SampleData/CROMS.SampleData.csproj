<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- Sample-data seeder (fictional Cagayan Valley records for demos and training). NOT in the
       .sln, like CROMS.MarriageTest: build it with  msbuild CROMS.SampleData\CROMS.SampleData.csproj
       It drives the application's own services (RegistryNumber, MarriageService, BreqsService,
       PaymentService, DelayedBirthService) and tags every row it writes "SAMPLE DATA 2026", so
       the cleanup mode removes exactly those rows and nothing else. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{5C2D7E41-93B0-4A6F-8E15-2B9F6D0A47C3}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>CROMS.SampleData</RootNamespace>
    <AssemblyName>CROMS.SampleData</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\CROMS\bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Core" />
    <Reference Include="System.Configuration" />
    <Reference Include="MySql.Data">
      <HintPath>..\packages\MySql.Data.9.7.0\lib\net462\MySql.Data.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <Compile Include="Program.cs" />
    <Compile Include="Gen.cs" />
    <Compile Include="SeedBirths.cs" />
    <Compile Include="SeedDeaths.cs" />
    <Compile Include="SeedMarriages.cs" />
    <Compile Include="SeedServices.cs" />
    <Compile Include="SeedQueue.cs" />
    <Compile Include="Cleanup.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CROMS\CROMS.csproj">
      <Project>{0887B5B8-8FD4-4DDC-B413-CA53B083C54A}</Project>
