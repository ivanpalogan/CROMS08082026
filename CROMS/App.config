<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- Folder of the Ionic mobile app. The desktop app auto-starts the Ionic
         dev server here on launch. Change if the mobile project lives elsewhere. -->
    <add key="IonicAppPath" value="C:\Users\ivan palogan\ORCMobile_Application" />
    <!-- Set to false to disable auto-starting the mobile dev server. -->
    <add key="IonicAutoStart" value="true" />
    <!-- Command run to start the mobile dev server (after cmd /c). TLS is configured
         in the Ionic app's own angular.json (ssl + ssl/dev-cert.pem), so the command
         itself needs no flags. -->
    <add key="MobileServeCommand" value="npx ng serve --host 0.0.0.0 --port 4200 --disable-host-check" />
    <!-- Trusted HTTPS for the phones (no certificate/profile to install). Free DuckDNS name:
         1) sign in at https://www.duckdns.org, create a subdomain, copy your token;
         2) set the two keys below. CROMS then points that name at this PC's private LAN IP
            (office-only, nothing exposed), keeps it updated when the IP/Wi-Fi changes, and
            gets/renews a Let's Encrypt certificate automatically (DNS-01, no open ports).
         Blank = not set up: the scanner runs on plain http://<LAN IP> (live camera unavailable).
         Keep this file private - the token can change the name's DNS. See ssl/README.md. -->
    <add key="MobileHostname" value="" />
    <add key="DuckDnsToken" value="" />
    <!-- Set to http only to force plain HTTP (https is used automatically once the cert exists). -->
    <add key="MobileScheme" value="https" />
    <!-- Command to start the save-API (Node) in &lt;IonicAppPath&gt;\server. -->
    <add key="MobileApiCommand" value="node index.js" />
    <!-- Wi-Fi/hotspot for the "join" QR. Leave blank to auto-read the Windows
         Mobile Hotspot; fill these to force specific credentials. -->
    <add key="HotspotSsid" value="" />
    <add key="HotspotPassword" value="" />
    <!-- Credentials CROMS uses to auto-connect to the \\server\CROMSRelease update
         share (so no manual `net use` is needed). ReleaseShareDomain defaults to the
         server IP; set it to the server's machine name (e.g. MSI) if the local account
         needs that instead. -->
    <add key="ReleaseShareUser" value="cromsshare" />
    <add key="ReleaseSharePassword" value="Croms#2026" />
    <add key="ReleaseShareDomain" value="" />
    <add key="LanDbUser" value="croms_user" />
    <add key="LanDbPassword" value="y1MqyIrdLew23Sok00B2" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <connectionStrings>
    <!-- CROMS database connection (local dev). If MySQL user/password
         changes, update user id / password below. -->
    <add name="Croms" connectionString="server=localhost;port=3306;database=croms;user id=root;password=ofAEusyUEy2DjvAnK2Z1;SslMode=Disabled;AllowPublicKeyRetrieval=True;Convert Zero Datetime=True;" providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>