        <!-- Separate visible service module branches -->
        <mxCell id="birth" value="&lt;b&gt;BIRTH REGISTRATION&lt;/b&gt;&lt;br&gt;Retrieve kiosk/client data&lt;br&gt;↓ Verify requirements&lt;br&gt;↓ Enter/verify birth record&lt;br&gt;↓ Attach/scan documents; OCR if needed&lt;br&gt;↓ Review/correct extracted data&lt;br&gt;↓ Validate and save birth registration&lt;br&gt;↓ Update registry + task COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="marapp" value="&lt;b&gt;MARRIAGE APPLICATION&lt;/b&gt;&lt;br&gt;Retrieve applicants and verify requirements&lt;br&gt;↓ Age 18–20? Require parental consent&lt;br&gt;↓ Age 21–25? Require parental advice&lt;br&gt;↓ Save application + posting stage&lt;br&gt;↓ Track posting period&lt;br&gt;↓ Process/issue marriage license&lt;br&gt;↓ Track validity + update status/history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="marreg" value="&lt;b&gt;MARRIAGE REGISTRATION / FORM 97&lt;/b&gt;&lt;br&gt;Pending task → receive Form 97&lt;br&gt;↓ Upload/scan OR mobile capture&lt;br&gt;↓ Attach image to pending record&lt;br&gt;↓ OCR extracts marriage information&lt;br&gt;↓ Staff verifies; correct if inaccurate&lt;br&gt;↓ Validate and register record&lt;br&gt;↓ PENDING → REGISTERED; store document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="death" value="&lt;b&gt;DEATH REGISTRATION&lt;/b&gt;&lt;br&gt;Retrieve client information&lt;br&gt;↓ Verify requirements&lt;br&gt;↓ Enter/verify death record&lt;br&gt;↓ Attach/scan/capture documents&lt;br&gt;↓ OCR and staff verification if needed&lt;br&gt;↓ Validate and save record&lt;br&gt;↓ Update registry + task COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1610" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="certificate" value="&lt;b&gt;CERTIFICATE REQUEST / CPC&lt;/b&gt;&lt;br&gt;Retrieve request → search civil records&lt;br&gt;↓ Record found? If NO record result/status&lt;br&gt;↓ If YES verify matched record&lt;br&gt;↓ Prepare certificate/certified copy&lt;br&gt;↓ Record processing/fees if used&lt;br&gt;↓ Generate/print certificate&lt;br&gt;↓ Status = READY FOR RELEASE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="2090" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="release" value="&lt;b&gt;RELEASE AND CLAIM&lt;/b&gt;&lt;br&gt;Require previous queue/reference&lt;br&gt;↓ Retrieve existing request&lt;br&gt;↓ Request found? If NO re-enter reference&lt;br&gt;↓ Verify ready status + claimant identity&lt;br&gt;↓ Valid and ready? If NO record reason&lt;br&gt;↓ If YES release document&lt;br&gt;↓ RELEASED/CLAIMED + task COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="2570" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="petition" value="&lt;b&gt;PETITION / CASE TRACKING&lt;/b&gt;&lt;br&gt;Retrieve petitioner + identify case type&lt;br&gt;RA 9048 • RA 10172 • Legal instrument • Court order&lt;br&gt;↓ Check requirements; create/open case&lt;br&gt;↓ Attach documents; record details&lt;br&gt;↓ Track status, actions and remarks&lt;br&gt;↓ Mark completed when appropriate&lt;br&gt;LCRO staff retain legal decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="3050" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="breqs" value="&lt;b&gt;PSA BREQS&lt;/b&gt;&lt;br&gt;Retrieve BREQS request&lt;br&gt;↓ Verify requester, subject, valid ID&lt;br&gt;↓ Review document type, copies, purpose&lt;br&gt;↓ Confirm relationship to owner&lt;br&gt;↓ Process and record request&lt;br&gt;↓ Track status&lt;br&gt;↓ Update Client Task + history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="3530" y="2170" width="455" height="240" as="geometry"/></mxCell>
        <mxCell id="ocr" value="&lt;b&gt;DOCUMENT MANAGEMENT / OCR&lt;/b&gt;&lt;br&gt;Upload • scan • mobile capture&lt;br&gt;↓ Store source image; send to OCR&lt;br&gt;↓ Extract and display fields&lt;br&gt;↓ Staff compares with original&lt;br&gt;↓ Accurate? Correct or accept values&lt;br&gt;↓ Validate and link to system record&lt;br&gt;↓ Store digital document + activity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E3;strokeColor=#B85450;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="4010" y="2170" width="455" height="240" as="geometry"/></mxCell>
