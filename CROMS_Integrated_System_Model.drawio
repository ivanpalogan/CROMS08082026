        <mxCell id="auditnote" value="Every login, verification, correction, status change, forwarding, release and administrative update writes to D10." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3250" y="3145" width="1290" height="85" as="geometry"/></mxCell>

        <!-- CLD loop panels surrounding the operational flow -->
        <mxCell id="cldheading" value="&lt;b&gt;INTEGRATED CAUSAL LOOPS&lt;/b&gt;&lt;br&gt;Red dashed influences connect these loops to operational variables in the swimlanes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#C62828;fontSize=14;fontColor=#8B1A1A;" vertex="1" parent="1"><mxGeometry x="4900" y="20" width="1100" height="80" as="geometry"/></mxCell>
        <mxCell id="b1" value="&lt;b&gt;B1 QUEUE PROCESSING LOOP&lt;/b&gt;&lt;br&gt;Client Transactions (+) → Waiting Queue (+) → Staff Workload (+) → Transactions Processed (+) → Completed Transactions (+) → Waiting Queue (−)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="4900" y="125" width="1100" height="185" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;B2 REQUIREMENTS LOOP&lt;/b&gt;&lt;br&gt;Missing Requirements (+) → Pending Transactions (+) → Processing Delay (+) → Queue / Workload (+)&lt;br&gt;Complete Requirements (+) → Successful Processing (+) → Pending Transactions (−)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="4900" y="335" width="1100" height="195" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;B3 CLIENT TASKS BALANCING LOOP&lt;/b&gt;&lt;br&gt;Selected Services (+) → Client Tasks (+) → Required Processing (+) → Staff Workload (+) → Completed Client Tasks (+) → Remaining Client Tasks (−)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="4900" y="555" width="1100" height="185" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;B4 OCR VALIDATION LOOP&lt;/b&gt;&lt;br&gt;Documents Digitized (+) → OCR Processing (+) → Extracted Data (+) → Staff Verification (+) → Validated Digital Records (+)&lt;br&gt;OCR Errors (+) → Corrections (+) → Processing Time (+)&lt;br&gt;Staff Verification (+) → Uncorrected OCR Errors (−) → Record Accuracy (+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="4900" y="765" width="1100" height="235" as="geometry"/></mxCell>
        <mxCell id="r1" value="&lt;b&gt;R1 MONITORING LOOP&lt;/b&gt;&lt;br&gt;Transaction Tracking (+) → Staff Visibility (+) → Staff Response (+) → Transactions Processed (+) → Updated Transaction Information (+) → Tracking Quality (+)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="4900" y="1025" width="1100" height="190" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b&gt;B5 WINDOW CAPACITY LOOP&lt;/b&gt;&lt;br&gt;Available Service Windows (+) → Processing Capacity (+) → Transactions Processed (+) → Waiting Queue (−) → Client Waiting Time (−)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C62828;fontSize=11;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="4900" y="1240" width="1100" height="180" as="geometry"/></mxCell>
        <mxCell id="cldnote" value="&lt;b&gt;Polarity&lt;/b&gt;: (+) variables move in the same direction; (−) variables move in opposite directions.&lt;br&gt;&lt;b&gt;B&lt;/b&gt; = balancing loop • &lt;b&gt;R&lt;/b&gt; = reinforcing loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE5E5;strokeColor=#C62828;fontSize=11;" vertex="1" parent="1"><mxGeometry x="4900" y="1450" width="1100" height="105" as="geometry"/></mxCell>

