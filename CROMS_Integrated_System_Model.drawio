        <mxCell id="mobilecapture" value="Mobile Capture Web App&lt;br&gt;Select pending marriage registration&lt;br&gt;Photograph Form 97 → send to CROMS Main" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="2590" width="455" height="100" as="geometry"/></mxCell>
        <mxCell id="servicetypes" value="&lt;b&gt;Kiosk service-specific intake&lt;/b&gt;&lt;br&gt;Birth: registrant + requirements • Marriage application: applicants, sex, age-related data • Marriage registration: pending task&lt;br&gt;Death: death/requester information • CPC: record, copies, purpose • Release: previous queue/reference only&lt;br&gt;Petition: type, reference, requirements • BREQS: document, copies, purpose, relationship, ID, subject, date/place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="170" y="2710" width="4295" height="100" as="geometry"/></mxCell>

